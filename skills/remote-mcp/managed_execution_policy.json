{
  "schema": "remotemcp.managed-execution-governance.v1",
  "mode": "fail-closed",
  "mandatory_preflight_before": [
    "chatgpt_web_session_binding",
    "device_pair_begin",
    "device_pair_local_dedicated_node",
    "device_revoke",
    "device_restart",
    "project_register_on_device",
    "project_bind_device",
    "scientific_job_relaunch",
    "device_capacity_status"
  ],
  "identity": {
    "existing_approved_role_identity": "preserve",
    "repair_by_repairing": false,
    "repair_by_revoke_replace": false,
    "ambiguity": "block"
  },
  "pairing": {
    "ticket_is_authorization": false,
    "requires_explicit_dedicated_node_gate": true,
    "requires_exact_approved_device_role": true,
    "requires_exact_approved_root": true,
    "requires_exact_approved_runtime_dir": true,
    "allowed_secret_transports": [
      "local-managed-pairing",
      "dedicated-managed-pairing-action"
    ],
    "forbidden_secret_transports": [
      "run-command",
      "routed-job",
      "job-argv",
      "shell-argument",
      "task-payload",
      "repository",
      "log",
      "checkpoint",
      "lineage"
    ],
    "secure_local_dedicated_node_action": {
      "enabled": true,
      "tool": "device_pair_local_dedicated_node",
      "local_host_only": true,
      "pairing_code_tool_argument_forbidden": true,
      "pairing_code_shell_argument_forbidden": true,
      "exact_pairing_id_required": true,
      "exact_device_name_required": true,
      "exact_node_root_required": true,
      "exact_runtime_dir_required": true,
      "explicit_scope_acknowledgement_required": true,
      "preserve_existing_identity": true,
      "replace_existing_paired_identity": false,
      "node_process_start_is_separate_action": true,
      "replay_after_partial_consume": "recover_only_if_exact_local_key_matches_central_paired_device",
      "result_must_not_include_pairing_secret": true
    }
  },
  "project_root_mismatch": {
    "decision": "BLOCKED_ON_MANAGED_PROJECT_EXPOSURE_OR_EXPLICIT_DEDICATED_NODE_GATE",
    "auto_create_node": false,
    "widen_existing_root": false,
    "repair_by_pairing": false
  },
  "restart": {
    "connector_session_failure_is_node_failure": false,
    "gateway_failure_is_node_failure": false,
    "root_mismatch_is_node_failure": false,
    "active_jobs_require_explicit_confirmation": true,
    "verify_same_identity_after_restart": true
  },
  "scientific_job": {
    "observability_loss_allows_relaunch": false,
    "relaunch_requires_explicit_authorization": true,
    "preserve_existing_task_job_identity": true,
    "preexecution_routed_submit_recovery": {
      "enabled": true,
      "supported_original_error_codes": [
        "PATH_ESCAPE"
      ],
      "require_same_proxy_job_id": true,
      "preserve_original_argv": true,
      "require_original_argv_sha256_acknowledgement": true,
      "recovery_cwd": ".",
      "require_cwd_semantics_acknowledgement": true,
      "authoritative_node_proxy_probe_before_submit": true,
      "replacement_proxy_forbidden": true,
      "second_scientific_one_shot_forbidden": true,
      "sql_or_node_db_repair_forbidden": true,
      "ambiguous_or_offline_decision": "block"
    },
    "postrun_evidence_readback": {
      "enabled": true,
      "declare_before_execution": true,
      "declaration_field": "evidence_paths",
      "exact_files_only": true,
      "require_authoritative_terminal_job": true,
      "readback_status_tool": "task_job_artifact_status",
      "readback_tool": "task_job_artifact_read",
      "read_requires_stat_pinned_sha256": true,
      "same_proxy_job_id_required": true,
      "scientific_rerun_on_readback_failure": false,
      "arbitrary_filesystem_read_forbidden": true,
      "undeclared_legacy_decision": "POSTRUN_EVIDENCE_PATH_UNDECLARED",
      "missing_declared_file_decision": "POSTRUN_EVIDENCE_NOT_FOUND",
      "sql_or_node_db_repair_forbidden": true,
      "submit_tool": "task_job_submit_with_evidence",
      "locked_submit_tool_preserved": "task_job_submit"
    },
    "preproxy_submit_recovery": {
      "enabled": true,
      "status_tool": "task_job_submit_failure_status",
      "recovery_tool": "task_job_recover_preproxy_submit",
      "legacy_intent_adoption_tool": "task_job_adopt_legacy_submit_intent",
      "frozen_intent_before_admission": true,
      "preserve_original_operation_id": true,
      "preserve_original_argv": true,
      "require_original_argv_sha256_acknowledgement": true,
      "recoverable_error_codes": [
        "PREDECESSOR_STATE_UNRESOLVED",
        "PREDECESSOR_JOB_NOT_TERMINAL",
        "TASK_JOB_ADMISSION_CONFLICT",
        "DEVICE_OFFLINE",
        "DB_BUSY"
      ],
      "authoritative_predecessor_reconciliation_before_proxy": true,
      "replacement_proxy_before_recovery_forbidden": true,
      "second_scientific_one_shot_forbidden": true,
      "legacy_adoption_requires_exact_historical_request_hash": true,
      "binding_identity_change_decision": "block",
      "ambiguous_or_nonrecoverable_decision": "block"
    },
    "execution_lifecycle_recovery_order": [
      "task_job_submit_failure_status",
      "task_job_recover_preproxy_submit",
      "task_job_recovery_status",
      "task_job_recover_path_escape",
      "task_job_artifact_status",
      "task_job_artifact_read"
    ],
    "zero_command_observation": {
      "enabled": true,
      "tool": "task_job_inspect",
      "requires_task_lease": false,
      "creates_device_command": false,
      "preferred_before_refreshing_get_logs_or_result": true,
      "observability_loss_allows_relaunch": false,
      "pending_readback_decision": "RETURN_OBSERVATION_REFRESH_PENDING_WITH_EXISTING_PROVENANCE",
      "automatic_scientific_rerun_for_readback_forbidden": true,
      "scientific_observability_ready_for_fresh_one_shot_requires": [
        "capacity_resolved",
        "active_job_identity_complete",
        "gateway_node_release_attestation_match",
        "node_execution_root_attested",
        "node_runtime_dir_attested"
      ],
      "rolling_upgrade_rule": "CAPACITY_TRUTH_AND_PROVENANCE_READINESS_ARE_SEPARATE"
    },
    "exactly_once_execution": {
      "enabled": true,
      "submit_tool": "task_job_submit_once",
      "execution_key_material": [
        "project_id",
        "immutable_base_commit",
        "scientific_gate",
        "argv",
        "cwd",
        "evidence_paths"
      ],
      "same_execution_key_running_decision": "ADOPT_EXISTING_EXECUTION",
      "same_execution_key_terminal_decision": "RETURN_EXISTING_EXECUTION",
      "replacement_proxy_forbidden": true,
      "second_scientific_one_shot_forbidden": true
    }
  },
  "infrastructure": {
    "use_scientific_task_as_transport": false,
    "append_to_scientific_lineage_by_default": false
  },
  "plugin_session_binding": {
    "canonical_web_plugin_name": "remote-mcp-v2-web-clean",
    "legacy_web_plugin_name": "remote-mcp-v2-web",
    "canonical_web_transport": "app-backed",
    "legacy_web_transport": "direct-mcp",
    "canonical_display_must_differ_from_legacy": true,
    "canonical_package_forbidden_files": [
      ".mcp.json",
      "mcp.json"
    ],
    "failure_decision": "PLUGIN_SESSION_BINDING_FAILURE",
    "node_repair_actions_forbidden": [
      "pair",
      "re-pair",
      "revoke-replace",
      "node-restart",
      "root-widening",
      "replacement-project-register",
      "scientific-job-relaunch"
    ],
    "fresh_conversation_required_for_final_session_smoke_after_release_change": true
  },
  "project_workspace_isolation": {
    "enabled": true,
    "layout_version": "PROJECT_WORKSPACE_V1",
    "project_workspace_template": ".remotemcp/workspaces/{project_id}",
    "worktrees_root_template": ".remotemcp/workspaces/{project_id}/worktrees",
    "task_worktree_template": ".remotemcp/workspaces/{project_id}/worktrees/{task_id}",
    "agent_selects_worktree_path": false,
    "direct_git_worktree_mutations_forbidden": true,
    "direct_git_worktree_observation_allowed": [
      "list"
    ],
    "legacy_layout": ".remote-worktrees/{project_id}/{task_id}",
    "legacy_existing_tasks": "preserve_until_safe_closure_or_explicit_migration",
    "move_or_delete_active_worktrees": false,
    "arbitrary_sibling_worktree_decision": "WORKTREE_LAYOUT_VIOLATION",
    "direct_mutation_decision": "WORKTREE_MUTATION_FORBIDDEN"
  },
  "resource_capacity_governance": {
    "authoritative_tool": "device_capacity_status",
    "authoritative_signal": "signed_node_heartbeat.reconciled_durable_job_state",
    "registry_nonterminal_routed_jobs_is_inventory_only": true,
    "device_list_active_routed_jobs_is_capacity_signal": false,
    "node_must_reconcile_nonterminal_routed_rows_before_heartbeat": true,
    "unresolved_node_rows_make_capacity_unresolved": true,
    "old_or_unreconciled_node_heartbeat_decision": "unresolved_fail_closed",
    "offline_or_stale_capacity_decision": "unresolved_fail_closed",
    "active_node_jobs_positive_decision": "recheck_cpu_ram_and_scientific_contention_before_fresh_one_shot",
    "active_node_jobs_zero_decision": "continue_other_resource_gates",
    "device_restart_must_use_authoritative_capacity": true,
    "registry_count_must_not_block_science_by_itself": true,
    "active_job_identity_signal": "signed_node_heartbeat.active_job_summaries",
    "reconciled_heartbeat_must_identify_every_active_job": true
  },
  "managed_task_base_pinning": {
    "enabled": true,
    "routed_task_create_must_resolve_on_bound_device": true,
    "remote_only_origin_branch_fetch_allowed": true,
    "exact_base_commit_required_before_ready": true,
    "nullable_base_commit_for_new_git_task": false,
    "node_worktree_must_use_pinned_base_commit": true,
    "legacy_null_base_commit_repair_on_claim": true,
    "invalid_or_unresolvable_base_decision": "TASK_BASE_REF_UNRESOLVED",
    "deterministic_local_fallback_forbidden": true
  },
  "control_plane_command_recovery": {
    "device_command_pending_decision": "retry_same_operation_id",
    "device_command_expired_decision": "retry_same_operation_id",
    "expired_command_reuse": "same_command_id_requeue",
    "replacement_command_for_same_operation_step": false,
    "local_execution_fallback_forbidden": true,
    "scientific_contract_change_forbidden": true,
    "control_plane_priority": [
      "NODE_RESTART",
      "JOB_CANCEL",
      "TASK_BASE_RESOLVE",
      "TASK_WORKTREE_ENSURE",
      "PROJECT_PROBE",
      "PROJECT_BIND"
    ],
    "command_ttl_must_exceed_gateway_wait": true
  },
  "storage_policy": {
    "windows_production_research_root": "NON_OS_RESEARCH_ROOT",
    "os_drive_research_project_worktree_storage_forbidden": true,
    "os_drive_runtime_only_allowed": [
      "%LOCALAPPDATA%\\RemoteMCP\\runtime",
      "%LOCALAPPDATA%\\RemoteMCP\\node-venv",
      "%LOCALAPPDATA%\\RemoteMCP\\gateway-venv",
      "%LOCALAPPDATA%\\RemoteMCP\\gateway state/logs"
    ],
    "userprofile_workspace_default_forbidden": true,
    "historical_os_drive_workspace_status": "HISTORICAL_ONLY_DO_NOT_REUSE",
    "new_project_or_worktree_on_os_drive_decision": "BLOCK",
    "research_root_change_requires_repair_not_repairing": true,
    "preserve_device_identity_during_root_override": true,
    "historical_binding_identifiers": "LOCAL_DEPLOYMENT_ONLY",
    "historical_bindings_must_not_be_reused_for_new_science": true
  },
  "project_binding_lifecycle": {
    "historical_binding_tool": "project_binding_deprecate",
    "historical_binding_accepts_new_tasks": false,
    "historical_evidence_preserved": true,
    "delete_or_rewrite_history": false,
    "superseding_binding_must_be_active": true
  },
  "runtime_attestation": {
    "signed_node_heartbeat_fields": [
      "release_commit",
      "source_dir",
      "execution_root",
      "runtime_dir",
      "schema_version",
      "schema_sha256"
    ],
    "device_status_surfaces_node_attestation": true,
    "device_status_surfaces_gateway_attestation": true,
    "root_or_release_mismatch_decision": "BLOCK_UPGRADE_OR_FRESH_ONE_SHOT"
  },
  "deployment_upgrade_gate": {
    "policy": "NO_LIVE_AGENT_OR_EXECUTION_ACTIVITY",
    "upgrade_while_agents_or_jobs_active": false,
    "require_authoritative_active_node_jobs_zero": true,
    "require_authoritative_unresolved_node_jobs_zero": true,
    "require_capacity_reconciliation_complete": true,
    "require_fresh_agent_sessions_zero": true,
    "require_unexpired_task_leases_zero": true,
    "require_unexpired_device_commands_zero": true,
    "action_when_not_ready": "WAIT_DO_NOT_RESTART_OR_DEPLOY"
  }
}
