# Copy to .env for a private self-hosted deployment.
# .env and .env.* are gitignored; only this placeholder example is public.
# Never commit real deployment values back into this file.

PUBLIC_URL=https://mcp.example.com
PORT=<GATEWAY_PORT>

# Keep all deployment-specific paths private.
MCP_ROOT=<WORKSPACE_ROOT>
MCP_STATE=<PRIVATE_STATE_FILE>
MCP_RUNTIME_DIR=<PRIVATE_RUNTIME_DIR>

# Use only the redirect hosts required by your deployment.
ALLOWED_REDIRECT_HOSTS=<REDIRECT_HOST_1>,<REDIRECT_HOST_2>

# Optional physical-pilot labels. Do not commit real machine names.
REMOTEMCP_PILOT_HOST_A=<MACHINE_A_HOST>
REMOTEMCP_PILOT_HOST_B=<MACHINE_B_HOST>

# Optional qualification-only local paths.
REMOTEMCP_QUAL_WORKSPACE=<QUALIFICATION_WORKSPACE>
REMOTEMCP_QUAL_LLAMA_CLI=<LLAMA_CLI_PATH>

# Optional ChatGPT web-app packaging reference.
REMOTEMCP_CHATGPT_APP_ID=<CHATGPT_APP_ID>

# Do NOT store OWNER_PASSWORD, OAuth tokens, pairing secrets, node private keys,
# or any other credential in this file.
