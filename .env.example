# Copy to .env for a private self-hosted deployment.
# .env and .env.* are gitignored; only this example file is public.

PUBLIC_URL=https://mcp.example.com
PORT=8099

# Keep deployment-specific paths private.
MCP_ROOT=C:\path\to\workspace
MCP_STATE=C:\path\to\private-state\oauth-state.json
MCP_RUNTIME_DIR=C:\path\to\private-state\runtime

ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com,localhost,127.0.0.1

# Optional physical-pilot host labels. Do not commit real machine names.
REMOTEMCP_PILOT_HOST_A=MACHINE_A_HOST
REMOTEMCP_PILOT_HOST_B=MACHINE_B_HOST

# Do NOT store OWNER_PASSWORD here.
# Configure-RemoteMCP-Gateway.ps1 stores it locally using Windows DPAPI.
